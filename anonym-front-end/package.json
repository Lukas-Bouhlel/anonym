    "cov": "jest test/test_unitaires --coverage --collectCoverageFrom=\"src/context/**/*.{js,jsx}\" --collectCoverageFrom=\"src/router/PrivateRoute.jsx\"",
    "cov:all": "jest --coverage --collectCoverageFrom=\"src/**/*.{js,jsx}\"",
    "generate-doc": "jsdoc -c jsdoc.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
