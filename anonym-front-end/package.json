{
  "name": "anonym-front-end",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "build-preprod": "vite build --mode preprod",
